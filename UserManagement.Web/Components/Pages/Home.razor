@page "/"
@rendermode InteractiveServer
@using System.Text.Json
@inject UsersDataContext DataContext

<PageTitle>User Management</PageTitle>

<main class="user-management-shell">
	<section class="operation-panel" aria-labelledby="page-title">
		<div class="eyebrow">User Management</div>
		<h1 id="page-title">Explore the user directory</h1>
		<p class="intro">Enter search values, then choose an operation to query the loaded CSV data.</p>

		<div class="search-fields">
			<label for="email-lookup">Email address</label>
			<input id="email-lookup" type="email" @bind="emailLookup" @bind:event="oninput" placeholder="jane.smith@example.com" />

			<label for="age-threshold">Age threshold</label>
			<input id="age-threshold" type="number" min="0" @bind="ageInput" @bind:event="oninput" placeholder="30" />
		</div>

		<div class="operation-buttons">
			<button type="button" disabled="@buttonsDisabled" @onclick="OnFindByEmail">
				<span class="button-index">01</span>
				<span>Find user by email</span>
			</button>
			<button type="button" disabled="@buttonsDisabled" @onclick="OnFindOlderThan">
				<span class="button-index">02</span>
				<span>Find users older than threshold</span>
			</button>
			<button type="button" disabled="@buttonsDisabled" @onclick="OnAverageAge">
				<span class="button-index">03</span>
				<span>Calculate average age</span>
			</button>
		</div>
	</section>

	<section class="result-panel" aria-labelledby="result-title">
		<div class="result-heading">
			<div>
				<div class="eyebrow">Latest response</div>
				<h2 id="result-title">JSON result</h2>
			</div>
			<span class="status-dot" aria-hidden="true"></span>
		</div>
		<pre class="result-output">@resultJson</pre>
	</section>
</main>

@code {
	private readonly JsonSerializerOptions jsonOptions = new() { WriteIndented = true };
	private bool buttonsDisabled;
	private string emailLookup = string.Empty;
	private string ageInput = string.Empty;
	private string resultJson = string.Empty;

	protected override void OnInitialized()
	{
		if (!DataContext.IsLoaded)
		{
			buttonsDisabled = true;
			resultJson = JsonSerializer.Serialize(DataContext.ErrorMessage, jsonOptions);
			return;
		}

		resultJson = "Click a button to see a result.";
	}

	private void OnFindByEmail()
	{
		try
		{
			var lookup = emailLookup.Trim();
			if (string.IsNullOrWhiteSpace(lookup))
			{
				resultJson = JsonSerializer.Serialize("Error: An email address is required.", jsonOptions);
				return;
			}

			var user = DataContext.Service!.FindByEmail(lookup);
			object result = user is not null
				? user
				: $"User with email {lookup} was not found.";
			resultJson = JsonSerializer.Serialize(result, jsonOptions);
		}
		catch (Exception ex)
		{
			resultJson = JsonSerializer.Serialize($"Error: {ex.Message}", jsonOptions);
		}
	}

	private void OnFindOlderThan()
	{
		try
		{
			if (!int.TryParse(ageInput, out var ageThreshold) || ageThreshold < 0)
			{
				resultJson = JsonSerializer.Serialize("Error: Enter a valid non-negative age threshold.", jsonOptions);
				return;
			}

			var users = DataContext.Service!.FindOlderThan(ageThreshold).ToList();
			object result = users.Count > 0
				? users
				: $"No users older than {ageThreshold} were found.";
			resultJson = JsonSerializer.Serialize(result, jsonOptions);
		}
		catch (Exception ex)
		{
			resultJson = JsonSerializer.Serialize($"Error: {ex.Message}", jsonOptions);
		}
	}

	private void OnAverageAge()
	{
		try
		{
			var average = DataContext.Service!.GetAverageAge();
			resultJson = JsonSerializer.Serialize(average, jsonOptions);
		}
		catch (Exception ex)
		{
			resultJson = JsonSerializer.Serialize($"Error: {ex.Message}", jsonOptions);
		}
	}
}
